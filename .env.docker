# Docker environment configuration
# Database Configuration - uses gateway postgres
DB_HOST=gateway-postgres
DB_PORT=5432
DB_USERNAME=gateway_user
DB_PASSWORD=gateway_password
DB_NAME=subscription_service
DB_SYNCHRONIZE=false

# Server Configuration
PORT=3002
NODE_ENV=development

# Gateway Service (docker network)
GATEWAY_SERVICE_URL=http://gateway:8081

# Stripe Configuration
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Logging
LOG_LEVEL=debug
